generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  junior
  middle
  senior
}

enum QuestionType {
  theory
  practical
  code
  system_design
  troubleshooting
}

enum AccessLevel {
  free
  pro
}

enum UserPlan {
  free
  pro
  admin
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String?
  plan      UserPlan @default(free)

  proUntil  DateTime? @map("pro_until")
  createdAt DateTime  @default(now()) @map("created_at")

  attempts  Attempt[]
  bookmarks Bookmark[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  technologies Technology[]
  questions    Question[]

  @@map("categories")
}

model Technology {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  categoryId String?   @db.Uuid @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  questions Question[]

  @@index([categoryId])
  @@map("technologies")
}

model Question {
  id           String @id @default(uuid()) @db.Uuid
  title        String

  questionText String  @map("question_text")
  answerText   String? @map("answer_text")
  explanation  String?

  difficulty   Difficulty
  questionType QuestionType @map("question_type")

  // free = visible for everyone
  // pro = visible only for paid users
  accessLevel AccessLevel @default(free) @map("access_level")

  isActive Boolean @default(true) @map("is_active")
  verified Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryId   String? @db.Uuid @map("category_id")
  technologyId String? @db.Uuid @map("technology_id")

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  technology Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  attempts     Attempt[]
  bookmarks    Bookmark[]
  questionTags QuestionTag[]

  @@index([categoryId])
  @@index([technologyId])
  @@index([difficulty])
  @@index([questionType])
  @@index([accessLevel])
  @@index([isActive])
  @@index([verified])

  @@map("questions")
}

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  questionTags QuestionTag[]

  @@map("tags")
}

model QuestionTag {
  questionId String @db.Uuid @map("question_id")
  tagId      String @db.Uuid @map("tag_id")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])

  @@map("question_tags")
}

model Attempt {
  id String @id @default(uuid()) @db.Uuid

  userId     String @db.Uuid @map("user_id")
  questionId String @db.Uuid @map("question_id")

  userAnswer String? @map("user_answer")
  score      Int?
  feedback   String?

  createdAt DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([createdAt])

  @@map("attempts")
}

model Bookmark {
  userId     String @db.Uuid @map("user_id")
  questionId String @db.Uuid @map("question_id")

  createdAt DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])

  @@map("bookmarks")
}