generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String            @id @default(uuid())
  email     String            @unique
  hashPassword  String
  name      String?
  surname   String?

  role      ROLE              @default(USER)

  subscriptionCode String     @default("FREE")
  subscription Subscription   @relation(fields: [subscriptionCode], references: [id])

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

enum ROLE {
  USER
  MENTHOR
  ADMIN
}

enum DIFFICULTY {
  JUNIOR
  MIDDLE
  SENIOR
}

model Subscription {
  id            String   @id
  name          String 
  price         Int
  durationDays  Int
  
  Users         User[]
}

model Question {
  id          String      @id @default(uuid())
  text        String
  explanation String?
  difficulty  DIFFICULTY  @default(MIDDLE)
  source      String?
  createdAt   DateTime    @default(now())

  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])

  tags        Tag[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique   //for beautidul URL's
  questions   Question[]
}

model Tag {
  id          String    @id @default(uuid())
  name        String    @unique
  questions   Question[]
}

