generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  junior
  middle
  senior
}

enum QuestionType {
  theory
  practical
  code
  system_design
  troubleshooting
}

enum AccessLevel {
  free
  pro
}

enum UserPlan {
  free
  pro
  admin
}

enum SubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
}

enum JobApplicationStatus {
  wishlist
  applied
  phone_screen
  technical
  final_round
  offer
  rejected
}

enum ExamSessionStatus {
  in_progress
  review
  completed
  expired
}

enum Assessment {
  know
  partial
  dont_know
}

model User {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String   @unique
  name           String?
  authProviderId String?  @unique @map("auth_provider_id")
  plan           UserPlan @default(free)

  proUntil  DateTime? @map("pro_until")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  attempts        Attempt[]
  bookmarks       Bookmark[]
  subscriptions   Subscription[]
  jobApplications JobApplication[]
  examSessions    ExamSession[]

  @@map("users")
}

model Category {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  technologies Technology[]
  questions    Question[]

  @@map("categories")
}

model Technology {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique
  slug        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryId String?   @map("category_id") @db.Uuid
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  questions       Question[]
  jobApplications JobApplicationTechnology[]

  @@index([categoryId])
  @@map("technologies")
}

model Question {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title   String
  slug    String  @unique
  excerpt String?

  questionText String  @map("question_text")
  answerText   String? @map("answer_text")
  explanation  String?
  codeSnippet  String? @map("code_snippet")

  difficulty   Difficulty
  questionType QuestionType @map("question_type")

  // free = visible for everyone
  // pro = visible only for paid users
  accessLevel AccessLevel @default(free) @map("access_level")

  isActive Boolean @default(true) @map("is_active")
  verified Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  categoryId   String? @map("category_id") @db.Uuid
  technologyId String? @map("technology_id") @db.Uuid

  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  technology Technology? @relation(fields: [technologyId], references: [id], onDelete: SetNull)

  attempts             Attempt[]
  bookmarks            Bookmark[]
  questionTags         QuestionTag[]
  examSessionQuestions ExamSessionQuestion[]

  @@index([categoryId])
  @@index([technologyId])
  @@index([difficulty])
  @@index([questionType])
  @@index([accessLevel])
  @@index([isActive])
  @@index([verified])
  @@map("questions")
}

model Tag {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @unique
  slug String @unique

  questionTags QuestionTag[]

  @@map("tags")
}

model QuestionTag {
  questionId String @map("question_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("question_tags")
}

model Attempt {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId     String @map("user_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid

  userAnswer String?     @map("user_answer")
  assessment Assessment?
  score      Int?
  feedback   String?

  createdAt DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  examSessionQuestion ExamSessionQuestion?

  @@index([userId])
  @@index([questionId])
  @@index([createdAt])
  @@map("attempts")
}

model Bookmark {
  userId     String @map("user_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([questionId])
  @@map("bookmarks")
}

model Subscription {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  stripePriceId        String? @map("stripe_price_id")

  status            SubscriptionStatus @default(incomplete)
  currentPeriodEnd  DateTime?          @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model JobApplication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  company  String
  role     String
  location String?
  salary   String? @map("salary")
  jobUrl   String? @map("job_url")

  status JobApplicationStatus @default(wishlist)
  note   String?

  customTechnologies String[] @default([]) @map("custom_technologies")

  appliedAt  DateTime? @map("applied_at")
  followUpAt DateTime? @map("follow_up_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  technologies JobApplicationTechnology[]
  statusEvents JobApplicationStatusEvent[]

  @@index([userId])
  @@index([status])
  @@index([appliedAt])
  @@index([followUpAt])
  @@index([userId, status])
  @@index([userId, updatedAt])
  @@index([userId, appliedAt])
  @@index([userId, followUpAt])
  @@index([userId, company])
  @@map("job_applications")
}

model JobApplicationTechnology {
  jobApplicationId String @map("job_application_id") @db.Uuid
  technologyId     String @map("technology_id") @db.Uuid

  jobApplication JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  technology     Technology     @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([jobApplicationId, technologyId])
  @@index([technologyId])
  @@map("job_application_technologies")
}

model JobApplicationStatusEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  jobApplicationId String         @map("job_application_id") @db.Uuid
  jobApplication   JobApplication @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)

  fromStatus JobApplicationStatus? @map("from_status")
  toStatus   JobApplicationStatus  @map("to_status")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([jobApplicationId])
  @@index([toStatus])
  @@index([createdAt])
  @@index([jobApplicationId, createdAt])
  @@map("job_application_status_events")
}

model ExamSession {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  examSlug        String            @map("exam_slug")
  status          ExamSessionStatus @default(in_progress)
  questionCount   Int               @map("question_count")
  durationMinutes Int               @map("duration_minutes")

  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime  @map("expires_at")
  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  questions ExamSessionQuestion[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("exam_sessions")
}

model ExamSessionQuestion {
  sessionId  String  @map("session_id") @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  attemptId  String? @unique @map("attempt_id") @db.Uuid
  position   Int

  userAnswer String?   @map("user_answer")
  savedAt    DateTime? @map("saved_at")

  session  ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  attempt  Attempt?    @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@id([sessionId, questionId])
  @@unique([sessionId, position])
  @@index([questionId])
  @@map("exam_session_questions")
}
