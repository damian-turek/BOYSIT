{
  "name": "api",
  "version": "1.0.0",
  "scripts": {
    "predev": "pnpm --filter database build",
    "dev": "concurrently -n api,stripe -c blue,magenta \"nest start --watch\" \"pnpm stripe:listen\" --kill-others-on-fail",
    "stripe:listen": "node --env-file=.env scripts/stripe-listen.mjs",
    "prebuild": "pnpm --filter database build",
    "build": "nest build",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "database": "workspace:*",
    "fastify": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@stripe/cli": "1.53.1",
    "@types/node": "^22.15.3",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
