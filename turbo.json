{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["PAYLOAD_DATABASE_URL", "PAYLOAD_DB_PUSH", "PAYLOAD_SECRET", "NEXT_PUBLIC_SERVER_URL"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
