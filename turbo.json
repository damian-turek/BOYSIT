{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["PAYLOAD_DATABASE_URL", "PAYLOAD_DB_PUSH", "PAYLOAD_SECRET", "NEXT_PUBLIC_SERVER_URL"],
  "ui": "tui",
  "globalEnv": ["DATABASE_URL", "DIRECT_URL"],
  "tasks": {
    "db:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^db:generate", "^check-types"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}